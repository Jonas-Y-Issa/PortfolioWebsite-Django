# Environment files and local credentials.
.env
.env.*
!.env.example
!.env.*.example
/.aws/

# Python virtual environments and caches.
env/
venv/
.venv/
websiteVEnv/
*.py[cod]
__pycache__/
.pytest_cache/
.ruff_cache/

# Local databases, SQLite sidecars, and private backups.
*.sqlite3
*.sqlite3-*
*.sqlite
*.sqlite-*
*.db
*.db-*
/.local-backups/

# Generated static files and runtime logs.
staticfiles/
/build/
/.wrangler/
# Django supplies admin assets; copied versions override installed security fixes.
myapp/static/admin/
*.log

# Test coverage output.
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local editor state and operating-system metadata.
.idea/
.DS_Store
*~
*.kate-swp
